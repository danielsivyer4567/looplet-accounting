# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Environment files (never commit secrets)
.env
.env.local
.env.development
.env.test
# .env.production is committed — only contains public VITE_ values
# (Supabase anon key + URL are designed to be public, protected by RLS)
!.env.production

# Supabase local
supabase/.branches
supabase/.temp

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Test artefacts
coverage/
.nyc_output/
tmp/

# Generated types (regenerate via npm run supabase:types)
src/lib/database.types.ts

# Claude Code scratch (ledgers, check markers — transient work-tracking)
.claude/scratch/

# graphify knowledge graph output (generated, not source)
graphify-out/

# Personal Claude Code overrides (not committed)
.claude/settings.local.json

# kleosrules runtime state (velocity log, intent snapshots)
state/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
