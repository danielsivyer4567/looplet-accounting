# Looplet Accounting — environment template
# Copy to .env.local and fill in values. Never commit .env.local.

# Supabase project (production = the live AFGC pilot project)
VITE_SUPABASE_URL=https://dxoikltymmknxqpkpyhi.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_REF=dxoikltymmknxqpkpyhi

# Service-role key — for migrations + edge functions ONLY. Never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OCR provider (one of: openai | groq | anthropic | kimi)
OCR_PROVIDER=groq
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
ANTHROPIC_API_KEY=
KIMI_API_KEY=
KIMI_VISION_MODEL=kimi-latest

# Xero (per-org OAuth — these are the global app credentials)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=

# Frontend-exposed Xero values (VITE_ prefix → bundled into client JS).
# VITE_XERO_REDIRECT_URI must EXACTLY match what's registered at developer.xero.com.
# Leave blank in dev to fall back to `${origin}/settings/xero-callback`.
VITE_XERO_CLIENT_ID=
VITE_XERO_REDIRECT_URI=

# Encryption key for at-rest secrets (32 chars; rotate via planned migration)
ENCRYPTION_KEY=

# Sentry (Phase 1 from day 1, per Foundational Disciplines)
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cron / edge-function secrets — DEPLOY-GATED. These must be set in the LIVE
# Supabase project (supabase secrets set ...), not just here. Local values do
# NOT affect production. See docs/CRON_SECRETS.md for what each consumes and how
# to provision. Use a random 32+ char string (e.g. `openssl rand -hex 16`).
#
# auto-reconcile-daily cron (mig 0065) -> auto-reconcile edge fn
AUTO_RECONCILE_CRON_SECRET=
# accountant-orchestrator (mig 0185) + notifications-cron handoff. Fails CLOSED:
# the orchestrator fn returns 500 if this is unset.
ACCOUNTANT_ORCHESTRATOR_CRON_SECRET=
# accruals-run-monthly cron (mig 0099) -> accruals-run edge fn (cron-only).
# Also needs CONNECTOR_JWT_SECRET set to post journals.
ACCRUALS_RUN_CRON_SECRET=
# depreciation-run-monthly cron (mig 0096) -> depreciation-run edge fn (cron-only).
# Also needs CONNECTOR_JWT_SECRET set to post journals.
DEPRECIATION_RUN_CRON_SECRET=

# Public app origin (NO trailing slash) for team/accountant invite links.
# Consumed by the team-invite edge fn for ${SITE_URL}/accept-invite. If unset it
# falls back to the Supabase API host, which breaks invite links. Deploy-gated.
SITE_URL=https://app.looplet.com
