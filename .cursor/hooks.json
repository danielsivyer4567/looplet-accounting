{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|StrReplace",
        "command": ".cursor/hooks/lean_gate.sh",
        "timeoutSec": 5,
        "failClosed": true
      },
      {
        "matcher": "Write|Edit|MultiEdit|StrReplace|Bash",
        "command": ".cursor/hooks/pre_tool_use.sh",
        "timeoutSec": 5,
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/before_submit_prompt.sh",
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/session_start.sh",
        "failClosed": false
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/session_end.sh",
        "failClosed": false
      }
    ],
    "subagentStart": [
      {
        "command": "./hooks/subagent_start.sh",
        "failClosed": false
      }
    ],
    "subagentStop": [
      {
        "command": "./hooks/subagent_stop.sh",
        "loop_limit": 3,
        "failClosed": false
      }
    ],
    "afterShellExecution": [
      {
        "command": "./hooks/after_shell.sh",
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "./hooks/before_read_file.sh",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop_gate.sh",
        "loop_limit": 5,
        "failClosed": false
      }
    ]
  }
}
