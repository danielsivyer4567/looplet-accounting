{
  "name": "looplet-accounting",
  "version": "0.1.0",
  "private": true,
  "description": "Looplet Accounting — job-costed AP/AR for trades businesses. Multi-tenant, Supabase-native, Xero-as-printer-driver.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"*.{ts,tsx,json,md}\"",
    "check:local-env": "node scripts/check-vite-env.mjs .env.local",
    "check:local-env-trial": "node scripts/check-vite-env-trial.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/test",
    "test:integration": "vitest run tests",
    "test:tenant-isolation": "vitest run tests/tenant-isolation.test.ts",
    "wrap:live-audit": "node examples/wrap-up-live-blocker-audit.mjs",
    "wrap:visual-smoke": "node examples/wrap-up-local-visual-smoke.mjs",
    "pos:validate": "node examples/pos-bridge/validate.mjs examples/pos-bridge/sample-receipt.json examples/pos-bridge/sample-refund.json examples/pos-bridge/sample-void.json",
    "pos:integration-fit-trial": "node examples/pos-bridge/integration-fit-trial.mjs",
    "pos:pilot-kit-trial": "node examples/pos-bridge/pilot-kit-trial.mjs",
    "pos:configure-env-trial": "node examples/pos-bridge/configure-env-trial.mjs",
    "pos:csv-trial": "node examples/pos-bridge/csv-adapter-trial.mjs",
    "pos:readiness": "node examples/pos-bridge/readiness.mjs",
    "pos:readiness-trial": "node examples/pos-bridge/readiness-trial.mjs",
    "pos:credential-probe-trial": "node examples/pos-bridge/credential-probe-trial.mjs",
    "pos:pilot-evidence-trial": "node examples/pos-bridge/pilot-evidence-trial.mjs",
    "pos:verify-pilot-evidence-trial": "node examples/pos-bridge/verify-pilot-evidence-trial.mjs",
    "pos:pilot-go-live-trial": "node examples/pos-bridge/pilot-go-live-trial.mjs",
    "pos:pilot-report-trial": "node examples/pos-bridge/pilot-report-trial.mjs",
    "pos:pilot-bundle-trial": "node examples/pos-bridge/pilot-bundle-trial.mjs",
    "pos:completion-audit-trial": "node examples/pos-bridge/completion-audit-trial.mjs",
    "pos:pilot-pass-trial": "node examples/pos-bridge/pilot-pass-trial.mjs",
    "pos:sample-fingerprint-trial": "node examples/pos-bridge/sample-fingerprint-trial.mjs",
    "pos:field-sample-capture-trial": "node examples/pos-bridge/field-sample-capture-trial.mjs",
    "pos:reconcile-pilot-evidence-trial": "node examples/pos-bridge/reconcile-pilot-evidence-trial.mjs",
    "pos:status-trial": "node examples/pos-bridge/status-trial.mjs",
    "pos:install-trial": "powershell -NoProfile -ExecutionPolicy Bypass -File examples/pos-bridge/install-windows-task-trial.ps1",
    "pos:package-trial": "powershell -NoProfile -ExecutionPolicy Bypass -File examples/pos-bridge/package-windows-bridge-trial.ps1",
    "pos:trial": "node examples/pos-bridge/trial.mjs",
    "pos:watch-trial": "node examples/pos-bridge/watch-trial.mjs",
    "pos:receipt-hub-visual-smoke": "node examples/pos-bridge/receipt-hub-visual-smoke.mjs",
    "pos:receipt-hub-cross-browser-smoke": "node examples/pos-bridge/receipt-hub-visual-smoke.mjs --browsers chromium,firefox",
    "pos:acceptance-trial": "node examples/pos-bridge/acceptance-trial.mjs",
    "pos:acceptance": "node examples/pos-bridge/acceptance.mjs",
    "pos:go-live": "node examples/pos-bridge/go-live.mjs",
    "pos:completion-audit": "node examples/pos-bridge/completion-audit.mjs",
    "pos:local-edge-trial": "node examples/pos-bridge/local-edge-trial.mjs",
    "pos:full-trial": "node examples/pos-bridge/full-trial.mjs",
    "pos:full-trial:artifact": "node examples/pos-bridge/full-trial.mjs --output .claude/scratch/pos-full-trial.json",
    "supabase:types": "supabase gen types typescript --project-id $VITE_SUPABASE_PROJECT_REF --schema public > src/lib/database.types.ts",
    "supabase:link": "supabase link --project-ref $VITE_SUPABASE_PROJECT_REF",
    "supabase:push": "supabase db push",
    "supabase:diff": "supabase db diff"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "postcss": "^8.5.16",
    "prettier": "^3.3.3",
    "supabase": "^2.108.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.6"
    },
    "js-yaml": "4.3.0",
    "undici": "7.28.0"
  },
  "engines": {
    "node": ">=20"
  }
}
